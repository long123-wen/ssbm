# Dependencies
node_modules/

# Build output
dist/
build/
out/
release-*/
dist-validation-*/
dist.zip
# deploy.mjs 构建前把旧 dist 改名留下的临时目录（文件被锁时删不掉）
.dist_old_*/
dist_trash*/
dist_timing/
dist_prev/

# Generated / temp artifacts
generated-avatars/
load-test-*.json

# Wrangler (Cloudflare) local state & cache
.wrangler/
.dev.vars
.wrangler-state/

# D1 database dumps (contain session tokens — never commit)
*.sql
d1-backup-*.sql

# Whitelist: handwritten DDL migrations are pure schema, safe to track
# (D1 dumps / backups above still take precedence because of "last match wins" semantics
# only when the ignore patterns are non-overlapping; here `d1-backup-*.sql` already covers
# the dump filename prefix, and `*.sql` is broad, so we use a `!` re-include to carve out
# the migrations directory only.)
!migrations/*.sql

# One-off debug/ad-hoc scripts
_check_*.py

# Test bundles (esbuild output for one-off validation scripts)
.test-bundle.mjs
.test-bundle.*.mjs

# Environment files (contains secrets)
.env
.env.local
.env.*.local
.env.*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Supabase
supabase/.temp/

# 临时查询输出与本地辅助文件
scripts/.d1-*.json
重新登录Cloudflare.bat
